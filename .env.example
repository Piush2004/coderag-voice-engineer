# Copy to .env and fill in what you have. The system runs with none of these set
# (local embeddings via fastembed, SQLite+Chroma storage) except the LLM key, which
# is required for /api/v1/chat (agent reasoning) — see docs/DECISIONS.md.

# --- LLM reasoning (required for chat/agent endpoints) ---
LLM_PROVIDER=anthropic          # anthropic | openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=

# --- Embeddings (optional — defaults to local fastembed, no key needed) ---
EMBEDDING_PROVIDER=fastembed    # fastembed | openai

# --- Voice (optional — frontend falls back to browser Web Speech API without these) ---
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# --- Agent safety limits ---
CODERAG_MAX_ITERATIONS=8
CODERAG_MAX_TOOL_CALLS=12
CODERAG_AGENT_TIMEOUT=60

# --- Storage ---
CODERAG_DATA_DIR=./data
